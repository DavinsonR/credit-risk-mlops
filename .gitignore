# Datos crudos y derivados: NUNCA se commitean
data/raw/*
data/interim/*
data/parquet/*
!data/**/.gitkeep

# Fixtures muestreados SI se commitean (CI corre sobre ellos)
!tests/fixtures/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secretos
.env
.env.*
!.env.example

# Artefactos locales
*.duckdb
*.duckdb.wal
mlruns/
.DS_Store
mlflow.db
mlartifacts/

# Artefactos intermedios de exports (regenerables): prefijo _
exports/_*

# JDK local para PySpark (bootstrap_jdk.py)
.jdk/

# El demo web usa copias de exports/onnx/ generadas al construir
serving/web/model.onnx
serving/web/contract.json
